# ============================================================
# WolfTune — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.
# ============================================================

# ---- Supabase (REQUIRED for auth) ---------------------------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- Spotify Web API (required for Phase 3 search) ----------
# https://developer.spotify.com → Dashboard → Your App
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ---- App URL -------------------------------------------------
# Used for redirects (auth callback, sign-out). In production this is your Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000